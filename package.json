{
  "name": "games-hoarder-viewer",
  "author": "Mahmoud Alfaham",
  "version": "1.0.0",
  "description": "A Steam-like library browser for your local game folders",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "test": "node --test \"tests/*.test.js\""
  },
  "devDependencies": {
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.gameshoarderviewer.app",
    "productName": "Games Hoarder Viewer",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "src/assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName} ${version}.exe"
    },
    "directories": {
      "output": "dist"
    }
  }
}
